{
  "name": "lp-fee-collector",
  "version": "1.0.0",
  "description": "Uniswap v3 position dashboard and fee collector",
  "main": "collector.js",
  "scripts": {
    "dashboard": "node server.js",
    "simulate": "node collector.js --mode=simulate",
    "collect": "node collector.js --mode=collect",
    "full": "node collector.js --mode=full",
    "approve": "node approve-serve.js",
    "test": "node test/run-all.js && eslint .",
    "smoke": "node test/smoke.js",
    "guardian": "node memecoin-guardian.js --once",
    "digest": "node digest.js --print",
    "daily": "node daily.js --print",
    "test:mobile": "python3 test/mobile-layout.py",
    "lint": "eslint ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "solc": "^0.8.36",
    "zod": "^4.5.4"
  },
  "license": "MIT",
  "overrides": {
    "tmp": ">=0.2.6"
  },
  "devDependencies": {
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.4",
    "eslint": "^10.10.0"
  }
}